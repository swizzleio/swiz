{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Print Version",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "cmd",
            "cwd": "${workspaceFolder}",
            "args": [
                "--appconfig",
                "file://test/data/cloudformation/app-config.yaml",
                "version"
            ]
        },
        {
            "name": "Go: Test (functional)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/test/functional",
            "debugAdapter": "legacy",
            "buildFlags": ["--tags=functionaltest"],
            //"args": ["--tags=functionaltest"],
            //"dlvFlags": ["--build-flags=\"-tags=functionaltest\""]
        },
        {
            "name": "Create awesomeEnv",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "cmd",
            "cwd": "${workspaceFolder}",
            "args": [
                "--appconfig",
                "file://test/data/cloudformation/app-config.yaml",
                "env",
                "deploy",
                "--name",
                "awesomeEnv"
            ]
        }
    ]
}